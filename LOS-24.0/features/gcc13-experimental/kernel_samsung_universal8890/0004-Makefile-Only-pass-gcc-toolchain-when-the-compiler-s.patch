From f1202a69093546172d9bd9dfe02512014c55d6f2 Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Sat, 17 Oct 2026 18:00:19 +0200
Subject: [PATCH 4/7] Makefile: Only pass -gcc-toolchain when the compiler
 supports it

-gcc-toolchain was removed from newer Clang releases; probe for it
with cc-option instead of failing the build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Makefile | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 83ed43b4796..bf1376b9c84 100644
--- a/Makefile
+++ b/Makefile
@@ -714,7 +714,11 @@ CLANG_TARGET	:= -target $(notdir $(CROSS_COMPILE:%-=%))
 GCC_TOOLCHAIN	:= $(realpath $(dir $(shell which $(LD)))/..)
 endif
 ifneq ($(GCC_TOOLCHAIN),)
-CLANG_GCC_TC	:= -gcc-toolchain $(GCC_TOOLCHAIN)
+# -gcc-toolchain was removed from newer Clang releases (it was only ever
+# needed to find a real GCC cross-toolchain's runtime libs; irrelevant
+# here since this device's toolchain is pure LLVM - ld.lld, llvm-ar, ...).
+# Probe for support instead of hard-failing on newer Clang.
+CLANG_GCC_TC	:= $(call cc-option, -gcc-toolchain $(GCC_TOOLCHAIN),)
 endif
 KBUILD_CFLAGS += $(CLANG_TARGET) $(CLANG_GCC_TC)
 KBUILD_AFLAGS += $(CLANG_TARGET) $(CLANG_GCC_TC)
-- 
