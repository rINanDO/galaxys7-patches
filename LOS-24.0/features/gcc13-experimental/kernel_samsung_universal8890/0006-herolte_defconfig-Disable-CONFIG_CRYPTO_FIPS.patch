From 9464542c7091dc6351914a521993169a576ca869 Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Sat, 17 Oct 2026 18:00:20 +0200
Subject: [PATCH 6/6] herolte_defconfig: Disable CONFIG_CRYPTO_FIPS

Skip Samsung's FIPS post-link HMAC step and boot-time crypto self-test
for the GCC 13.3 experimental kernel build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/configs/exynos8890-herolte_defconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/configs/exynos8890-herolte_defconfig b/arch/arm64/configs/exynos8890-herolte_defconfig
index e7642a7e860..1ba7e71eb19 100644
--- a/arch/arm64/configs/exynos8890-herolte_defconfig
+++ b/arch/arm64/configs/exynos8890-herolte_defconfig
@@ -4891,7 +4891,7 @@ CONFIG_CRYPTO=y
 #
 # Crypto core or helper
 #
-CONFIG_CRYPTO_FIPS=y
+# CONFIG_CRYPTO_FIPS is not set
 CONFIG_CRYPTO_ALGAPI=y
 CONFIG_CRYPTO_ALGAPI2=y
 CONFIG_CRYPTO_AEAD=y
-- 
2.51.0

