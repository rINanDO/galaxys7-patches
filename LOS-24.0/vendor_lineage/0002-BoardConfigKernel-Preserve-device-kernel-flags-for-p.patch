From 3709664f44bca677b560367224f825c74b2eace5 Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Fri, 9 Oct 2026 19:42:13 +0200
Subject: [PATCH 2/2] BoardConfigKernel: Preserve device kernel flags for
 pre-clang-built kernels

This file unconditionally resets KERNEL_MAKE_FLAGS and adds LLVM=1
LLVM_IAS=1 (plus other clang/BTF/rust-bindgen-era flags), assuming every
device builds a clang-built-linux kernel. Devices with kernels old enough
to predate that (3.x-era, GCC-only) had no way to opt out: their own
HOSTCC/HOSTCXX etc set in BoardConfig got silently wiped the moment this
file is pulled in (via BoardConfigLineage.mk, gated on LINEAGE_BUILD,
which normal brunch/breakfast builds set but a bare soong_ui.bash
invocation does not -- which is why this only surfaced once building
through brunch).

Capture the device's pre-existing KERNEL_MAKE_FLAGS before the reset
when TARGET_KERNEL_CLANG_COMPILE := false, and merge it back in after
this file's own additions, stripping the LLVM=1/LLVM_IAS=1 tokens
specifically (the rest -- HOSTCFLAGS/HOSTLDFLAGS sysroot, LZ4, PAHOLE,
LIBCLANG_PATH -- are all post-3.10 kbuild features that an old kernel's
Makefile simply won't reference, so they're harmless to leave in).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Change-Id: Id8efb97739d5f41f38c9e5c42cc5c8201848b897
---
 config/BoardConfigKernel.mk | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/config/BoardConfigKernel.mk b/config/BoardConfigKernel.mk
index ca1a52ad..8db4ddf7 100644
--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -139,6 +139,14 @@ else
     KERNEL_CC_WRAPPER := $(CCACHE_BIN)
 endif
 
+# Preserve any kernel make flags a pre-clang-era device config may already
+# have set. This file assumes a clang-built-linux kernel by default (see
+# LLVM=1 below); devices that set TARGET_KERNEL_CLANG_COMPILE := false
+# because their kernel predates clang-built-linux support need their own
+# HOSTCC/HOSTCXX etc, which get merged back in below instead of being wiped
+# out by the reset that follows.
+KERNEL_LEGACY_MAKE_FLAGS := $(if $(filter false,$(TARGET_KERNEL_CLANG_COMPILE)),$(KERNEL_MAKE_FLAGS))
+
 # Clear these first to prevent accidental poisoning from env
 KERNEL_BAZEL_FLAGS := $(TARGET_KERNEL_BAZEL_FLAGS)
 KERNEL_MAKE_FLAGS :=
@@ -199,6 +207,13 @@ KERNEL_MAKE_FLAGS += PAHOLE=$(BUILD_TOP)/prebuilts/kernel-build-tools/linux-x86/
 # Tell rust bindgen which libclang to parse the kernel headers with
 KERNEL_MAKE_FLAGS += LIBCLANG_PATH=$(TARGET_KERNEL_LIBCLANG_PATH)
 
+ifneq ($(KERNEL_LEGACY_MAKE_FLAGS),)
+    # This device's kernel predates clang-built-linux support; drop the
+    # LLVM-forcing flags above and merge back in whatever host toolchain
+    # flags it set instead.
+    KERNEL_MAKE_FLAGS := $(filter-out LLVM=1 LLVM_IAS=1,$(KERNEL_MAKE_FLAGS)) $(KERNEL_LEGACY_MAKE_FLAGS)
+endif
+
 # AutoFDO
 # Ideally, we also want to detect 'CONFIG_AUTOFDO_CLANG=y' from kernel configs...
 # Note: The path `toolchain/pgo-profiles/kernel` contains AutoFDO profiles too
-- 
